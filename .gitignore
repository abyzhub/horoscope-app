# ============================================================
# Horoscope App — .gitignore
# ============================================================

# --- Secrets & Environment ---
.env
*.env
!.env.example

# --- Python ---
backend/venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
.npm/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Misc ---
*.log
*.lock
tmp/
temp/
